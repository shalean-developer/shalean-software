# =============================================================================
# Shalean — environment reference (copy to `.env.local`; never commit secrets)
# =============================================================================

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Prefer Supabase publishable keys for new projects. Legacy anon key still works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase server-only (never expose to the browser) ---
# Paystack webhook, notification outbox worker (Next.js), auth email resolution
# Prefer Supabase secret keys for new projects. Legacy service_role key still works.
SUPABASE_SECRET_KEY=sb_secret_your-key
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack ---
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Public site URL (fallback when request headers have no origin — Paystack callbacks, emails) ---
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# --- Customer-facing links (optional — homepage & booking confirmations pick these up when set) ---
# NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://g.page/your-google-business/review
# NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com

# --- Resend / operational email ---
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=notifications@your-verified-domain.com
NOTIFICATIONS_FROM_NAME=Shalean
NOTIFICATIONS_ADMIN_EMAILS=ops@your-domain.com

# --- Notification worker auth (`/api/cron/notifications`) ---
# Long random string — Authorization: Bearer <NOTIFICATIONS_CRON_SECRET>
# Must match Vault secret `notifications_cron_secret` used by pg_cron (see DEPLOYMENT.md).
NOTIFICATIONS_CRON_SECRET=

# Worker lease duration (seconds) for claimed outbox rows; stale leases reclaim (default 180)
NOTIFICATION_OUTBOX_LEASE_SECONDS=180

# --- Staff reconciliation break-glass (optional) ---
# When ENABLED=true, SECRET must be at least 16 chars (same checks as server actions).
RECONCILIATION_OVERRIDE_ENABLED=false
RECONCILIATION_OVERRIDE_SECRET=

# --- Diagnostics ---
# Production: TEMP role diagnostics default OFF unless TEMP_ROLE_DIAG_ENABLED=true
TEMP_ROLE_DIAG_ENABLED=

# --- Legacy (optional) ---
# Vercel Cron only — Next route still accepts this if set. Prefer Supabase pg_cron + Vault.
# CRON_SECRET=
